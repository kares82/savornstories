---
const links = [
  { href: '/', label: 'Home' },
  { href: '/bordeaux', label: 'Bordeaux' },
  { href: '/dieppe', label: 'Dieppe' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---
<header class="bg-green">
  <div class="max-w-[480px] md:max-w-3xl lg:max-w-5xl mx-auto flex items-center justify-between px-4 md:px-6 py-3 md:py-4">
    <a href="/" class="flex items-center gap-2 text-cream font-bold text-sm md:text-base tracking-wide">
      <img src="/assets/favicon-32.png" alt="" width="22" height="22" class="rounded-full md:w-7 md:h-7" />
      Savor &amp; Stories
    </a>
    <nav class="flex gap-3 md:gap-6">
      {links.map((link) => {
        const active = path === link.href || (link.href !== '/' && path.startsWith(link.href));
        return (
          <a
            href={link.href}
            class={`text-[11px] md:text-xs font-bold tracking-wide uppercase ${active ? 'text-cream' : 'text-teal-soft'}`}
          >
            {link.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>
