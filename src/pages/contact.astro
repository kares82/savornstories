---
import Layout from '../layouts/Layout.astro';
---
<Layout
  title="Contact Antoine | Savor & Stories"
  description="Message Antoine directly on WhatsApp to book a tour in Bordeaux or Dieppe, or ask a question first."
>
  <div class="bg-green px-5 pt-8 pb-8 md:pt-14 md:pb-14 text-center">
    <h1 class="text-cream text-2xl md:text-4xl font-bold">Contact &amp; Booking Help</h1>
    <div class="w-10 h-0.5 bg-gold mx-auto my-3"></div>
    <p class="text-[13px] md:text-base text-[#e8e2d4] italic">Every booking goes through me directly, not a call center.</p>
  </div>

  <div class="max-w-[480px] md:max-w-xl mx-auto">
    <div class="px-4 md:px-6 pt-6 md:pt-10 pb-4">
      <div class="bg-white rounded-2xl border border-border p-5 md:p-7">
        <a
          href="https://wa.me/33626391783"
          target="_blank"
          rel="noopener"
          class="flex items-center justify-center gap-3 w-full py-4 bg-whatsapp text-white rounded-2xl font-bold text-base no-underline mb-3"
        >
          Message on WhatsApp
        </a>
        <a
          href="mailto:contact@savornstories.com"
          class="flex items-center justify-center gap-3 w-full py-4 bg-gradient-to-br from-green to-teal text-white rounded-2xl font-bold text-sm no-underline"
        >
          contact@savornstories.com
        </a>
      </div>
    </div>

    <div class="px-4 md:px-6 pb-8 md:pb-14 text-sm md:text-base text-ink-soft leading-relaxed">
      <p>
        Tell me which city, roughly how many people, and what dates you have in mind, and I will get back to you with times that work. If you're not sure which tour fits, just describe what you're after and I'll point you the right way.
      </p>
    </div>
  </div>
</Layout>
